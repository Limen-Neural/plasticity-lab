#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Limen-Neural contributors
# SPDX-License-Identifier: MIT OR Apache-2.0
set -euo pipefail

cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
SECONDS=0

# Amp orbs use Debian; this is not a cross-platform workstation installer.
echo 'Checking native build prerequisites'
missing=()
for package in build-essential curl ca-certificates; do
    if [[ "$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null)" != 'install ok installed' ]]; then
        missing+=("$package")
    fi
done
if ((${#missing[@]})); then
    elevate=()
    if [[ $(id -u) != 0 ]]; then
        elevate=(sudo -n)
    fi
    "${elevate[@]}" apt-get update
    "${elevate[@]}" apt-get install -y --no-install-recommends "${missing[@]}"
fi

export PATH="${CARGO_HOME:-$HOME/.cargo}/bin:$PATH"
if ! command -v rustup >/dev/null 2>&1; then
    echo 'Installing rustup (the repository selects the Rust version)'
    installer="$(mktemp)"
    trap 'rm -f -- "$installer"' EXIT
    curl --proto '=https' --tlsv1.2 --fail --silent --show-error \
        https://sh.rustup.rs -o "$installer"
    sh "$installer" -y --no-modify-path --default-toolchain none
fi

# Amp and supervised services use new login shells, not this setup process.
# rustup's env script avoids prepending Cargo's bin directory more than once.
# Use the first existing Bash login profile instead of shadowing it with a new
# higher-priority file. With no existing profile, create .profile.
profile="$HOME/.profile"
for candidate in .bash_profile .bash_login .profile; do
    if [[ -f "$HOME/$candidate" ]]; then
        profile="$HOME/$candidate"
        break
    fi
done
profile_line='. "${CARGO_HOME:-$HOME/.cargo}/env"'
if ! grep -Fqx "$profile_line" "$profile" 2>/dev/null; then
    printf '\n%s\n' "$profile_line" >> "$profile"
fi

echo 'Installing the toolchain and components from rust-toolchain.toml'
time rustup toolchain install --no-self-update

echo 'Fetching locked dependencies'
time cargo fetch --locked

echo 'Warming all-feature build and test caches'
time cargo build --locked --all-features
time cargo test --no-run --locked --all-features

echo "Orb setup finished in ${SECONDS}s"
